# Server
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=info
LOG_FORMAT=text

# Database (required)
# CockroachDB works out of the box (same PostgreSQL wire protocol):
# DATABASE_URL=postgres://root@localhost:26257/space?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/space
DB_MAX_CONNECTIONS=10

# Cache / rate limiting (optional, falls back to in-memory)
REDIS_URL=redis://localhost:6379

# Auth
ACCESS_TOKEN_TTL_SECS=900
REFRESH_TOKEN_TTL_SECS=2592000
SESSION_COOKIE_NAME=space_session
COOKIE_SECURE=false

# Bootstrap admin account (created on startup if set)
ADMIN_EMAIL=admin@space.local
ADMIN_PASSWORD=change-me-before-first-boot

# CORS: comma separated origins, empty = allow all
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false

# Storage
STORAGE_DIR=./data/storage
# Comma separated media library roots for the scanner
LIBRARY_ROOTS=./data/library

# Transcoding
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
TRANSCODE_HEIGHTS=1080,720,480

# External metadata providers
TMDB_API_KEY=
OMDB_API_KEY=
ANILIST_ENABLED=true

# Security hardening
PASSWORD_MIN_LENGTH=8
LOCKOUT_THRESHOLD=5
LOCKOUT_WINDOW_SECS=900
LOCKOUT_DURATION_SECS=900
RESET_LINK_BASE=http://localhost:8080/reset
PLUGIN_ALLOW_HTTP=true

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_AUTH_PER_MIN=20

# Background scanner interval in seconds, 0 disables
SCANNER_INTERVAL_SECS=0

# Playback security controller: short-lived signed playback grants
PLAYBACK_GRANT_TTL_SECS=600

# Admin AI copilot (optional OpenAI-compatible endpoint; heuristic mode works without it)
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Media protection (Phase J)
# Master secret for the key hierarchy: any passphrase or 32-byte hex.
# Leave empty to auto-generate and persist one. For production prefer a KMS.
MASTER_KEY=
# Encrypt HLS outputs with AES-128; keys served only to valid playback grants
HLS_ENCRYPTION=false
# When set, /api/playback/keys/* and /api/dl/* require header X-Origin-Token
# (inject it at your CDN/reverse proxy; direct internet access is rejected)
ORIGIN_INTERNAL_TOKEN=
# Offline playback license lifetime (seconds; clamped 3600..604800)
OFFLINE_LICENSE_TTL_SECS=86400

# Learned web sources (galaxy) â€” paste a site url, SPACE learns search+items.
WEB_SOURCES_ENABLED=true
# Path to the galaxy scraper binary; auto-discovers ./galaxy.exe,
# ../galaxy/target/release/galaxy.exe and PATH when unset.
GALAXY_BIN=
GALAXY_TIMEOUT_SECS=25

# Source hubs â€” remote SPACE servers used as fallback providers + recipe sync.
# Inbound: set SOURCE_HUB_TOKEN so other servers can call /api/hub/* with the
# X-Hub-Token header. Unset = this server's hub surface is loopback-only.
SOURCE_HUB_TOKEN=
HUB_TIMEOUT_SECS=15

# Stremio-compatible extension system (separate from plugins)
# Install addons by manifest url; browse the central index from /console.
EXTENSION_TIMEOUT_SECS=15

# Library playlist storage SPI backend (postgres; swap via library::store::PlaylistStore)
PLAYLIST_STORE_BACKEND=postgres

# Daily source benchmark worker (ratings drive fastest-first selection)
# No config needed; scores land in source_ratings and /api/sources/rankings
